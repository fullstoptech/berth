---
source: crates/berth-rules/src/recipes.rs
expression: "view(& plan_of(\"rust-axum\", & [5432]))"
---
source: Recipe("Rust")
after_write: Some(Up { services: [], build: true })
note: Writes a multi-stage Dockerfile for Rust.
note: Adds POSTGRES_PASSWORD to .env.

=== compose.yaml (Create, +30 -0, old hash none) ===
# Generated by Berth from the Rust recipe and the key names in .env
services:
  app:
    build: .
    ports:
      - "8080:8080"
    env_file: .env
    environment:
      DATABASE_URL: postgres://app:${POSTGRES_PASSWORD}@db:5432/app
    depends_on:
      db:
        condition: service_healthy
  db:
    image: postgres:17-alpine
    ports:
      - "5433:5432"
    environment:
      POSTGRES_USER: app
      POSTGRES_DB: app
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?set in .env}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U app -d app"]
      interval: 5s
      timeout: 3s
      retries: 10
    volumes:
      - rust-axum_pgdata:/var/lib/postgresql/data

volumes:
  rust-axum_pgdata:

=== Dockerfile (Create, +9 -0, old hash none) ===
FROM rust:1-slim-bookworm AS build
WORKDIR /src
COPY . .
RUN cargo build --release

FROM debian:bookworm-slim AS runtime
COPY --from=build /src/target/release/gateway /usr/local/bin/gateway
EXPOSE 8080
CMD ["gateway"]

