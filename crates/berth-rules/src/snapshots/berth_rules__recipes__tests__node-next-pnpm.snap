---
source: crates/berth-rules/src/recipes.rs
expression: "view(& plan_of(\"node-next-pnpm\", & [5432]))"
---
source: Recipe("Node")
after_write: Some(Up { services: [], build: true })
note: Reuses your Dockerfile for the app service.
note: Adds POSTGRES_PASSWORD to .env.

=== compose.yaml (Create, +53 -0, old hash none) ===
# Generated by Berth from the Dockerfile and the key names in .env
services:
  app:
    build: .
    ports:
      - "3000:3000"
    env_file: .env
    environment:
      DATABASE_URL: postgres://app:${POSTGRES_PASSWORD}@db:5432/app
      REDIS_URL: redis://redis:6379
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
    develop:
      watch:
        - action: sync
          path: .
          target: /app
          ignore:
            - node_modules/
            - .next/
            - dist/
        - action: rebuild
          path: package.json
  db:
    image: postgres:17-alpine
    ports:
      - "5433:5432"
    environment:
      POSTGRES_USER: app
      POSTGRES_DB: app
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?set in .env}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U app -d app"]
      interval: 5s
      timeout: 3s
      retries: 10
    volumes:
      - node-next-pnpm_pgdata:/var/lib/postgresql/data
  redis:
    image: redis:7.4-alpine
    ports:
      - "6379:6379"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 10

volumes:
  node-next-pnpm_pgdata:

