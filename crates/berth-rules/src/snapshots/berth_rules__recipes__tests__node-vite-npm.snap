note: Writes a multi-stage Dockerfile for Node.

=== compose.yaml (Create, +15 -0, old hash none) ===
# Generated by Berth from the Node recipe and the key names in .env
services:
  app:
    build: .
    ports:
      - "8080:80"
    develop:
      watch:
        - action: rebuild
          path: .
          ignore:
            - node_modules/
            - dist/
        - action: rebuild
          path: package.json

=== Dockerfile (Create, +14 -0, old hash none) ===
FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci

FROM node:22-alpine AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM nginx:1.29-alpine AS runtime
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80

