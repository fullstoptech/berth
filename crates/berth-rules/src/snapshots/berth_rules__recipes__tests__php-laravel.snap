---
source: crates/berth-rules/src/recipes.rs
expression: "view(& plan_of(\"php-laravel\", & [5432]))"
---
source: Recipe("PHP")
after_write: Some(Up { services: [], build: true })
note: Writes a multi-stage Dockerfile for PHP.
note: Adds MYSQL_PASSWORD to .env.

=== compose.yaml (Create, +62 -0, old hash none) ===
# Generated by Berth from the PHP recipe and the key names in .env
services:
  app:
    build: .
    ports:
      - "8000:8000"
    env_file: .env
    environment:
      DB_CONNECTION: mysql
      DB_HOST: db
      DB_PORT: "3306"
      DB_DATABASE: app
      DB_USERNAME: app
      DB_PASSWORD: ${MYSQL_PASSWORD}
      REDIS_HOST: redis
      MAIL_HOST: mailpit
      MAIL_PORT: "1025"
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
      mailpit:
        condition: service_healthy
  db:
    image: mysql:8.4
    ports:
      - "3306:3306"
    environment:
      MYSQL_USER: app
      MYSQL_PASSWORD: ${MYSQL_PASSWORD:?set in .env}
      MYSQL_ROOT_PASSWORD: ${MYSQL_PASSWORD:?set in .env}
      MYSQL_DATABASE: app
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -h 127.0.0.1 -u app -p$$MYSQL_PASSWORD --silent"]
      interval: 5s
      timeout: 3s
      retries: 20
    volumes:
      - php-laravel_mysqldata:/var/lib/mysql
  redis:
    image: redis:7.4-alpine
    ports:
      - "6379:6379"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 10
  mailpit:
    image: axllent/mailpit:v1.32
    ports:
      - "1025:1025"
      - "8025:8025"
    healthcheck:
      test: ["CMD", "/mailpit", "readyz"]
      interval: 5s
      timeout: 3s
      retries: 10

volumes:
  php-laravel_mysqldata:

=== Dockerfile (Create, +13 -0, old hash none) ===
FROM composer:2 AS vendor
WORKDIR /app
COPY composer.json composer.lock* ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist
COPY . .
RUN composer dump-autoload --optimize --no-dev

FROM php:8.4-cli-alpine AS runtime
WORKDIR /app
RUN docker-php-ext-install pdo_mysql
COPY --from=vendor /app ./
EXPOSE 8000
CMD ["php", "artisan", "serve", "--host=0.0.0.0", "--port=8000"]

